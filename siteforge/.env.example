# Copy this file to ".env" and fill in what you need. Everything is optional for local testing.

# ---- Your business ----
BRAND_NAME=SiteCraft
# Your main address. Locally leave as is. In production: https://yourdomain.com
APP_URL=http://localhost:3000
PORT=3000
# The domain you bought. Client sites live at <name>.ROOT_DOMAIN (defaults to APP_URL's host)
# ROOT_DOMAIN=yourdomain.com
# Your email(s): these accounts get the /admin panel
ADMIN_EMAILS=you@example.com
# Shown to clients who want to pay by bank transfer / WiPay
CONTACT_WHATSAPP=18765550000
CONTACT_EMAIL=

# ---- AI (Anthropic Claude) ----
# Without a key, new sites use the built-in template and AI edits are switched off.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# ---- Storage ("the bucket") ----
# local = a folder in ./data/bucket (for testing). s3 = Cloudflare R2 / AWS S3 / any S3-compatible bucket.
STORAGE_DRIVER=local
# S3_BUCKET=client-sites
# S3_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---- Plans ----
TRIAL_DAYS=14
CURRENCY=USD
PRICE_STARTER=15
PRICE_BUSINESS=35
# AI changes allowed per month (keeps your AI bill under control)
AI_LIMIT_TRIAL=15
AI_LIMIT_STARTER=60
AI_LIMIT_BUSINESS=250

# ---- Card payments (Lemon Squeezy) ----
# Leave empty until you set it up; clients will be told to message you to pay instead.
LEMON_CHECKOUT_STARTER=
LEMON_CHECKOUT_BUSINESS=
LEMON_VARIANT_STARTER=
LEMON_VARIANT_BUSINESS=
LEMON_WEBHOOK_SECRET=

# Where the database and local bucket live (keep this on a disk that survives restarts)
# DATA_DIR=./data
