# Copy this file to ".env" and fill in what you need. Everything is optional for local testing.

# ---- Your business ----
BRAND_NAME=The Webber
# Your main address. Locally leave as is. In production: https://yourdomain.com
APP_URL=http://localhost:3000
PORT=3000
# The domain you bought. Client sites live at <name>.ROOT_DOMAIN (defaults to APP_URL's host)
# ROOT_DOMAIN=yourdomain.com
# Your email(s): these accounts get the /admin panel
ADMIN_EMAILS=you@example.com
# Shown to clients who want to pay by bank transfer / WiPay
CONTACT_WHATSAPP=18765550000
CONTACT_EMAIL=

# ---- AI ----
# Option A (recommended, cheap): OpenRouter free models.
#   Buy $10 of credits ONCE at openrouter.ai and free (":free") models allow 1000 requests/day
#   (without the purchase it is 50/day). Create a key at openrouter.ai/keys.
OPENROUTER_API_KEY=
# Best first, comma separated. Empty = built-in list of strong free models. If one is busy or
# returns junk, the next is tried automatically.
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,qwen/qwen3-coder:free
OPENROUTER_DAILY_LIMIT=1000
# Option B: Anthropic Claude (paid per use). Used when no OpenRouter key is set.
# AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Without any key, new sites are built from the built-in template.

# ---- Storage ("the bucket") ----
# local = a folder in ./data/bucket (for testing). s3 = Cloudflare R2 / AWS S3 / any S3-compatible bucket.
STORAGE_DRIVER=local
# S3_BUCKET=client-sites
# S3_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---- Plans ----
TRIAL_DAYS=14
CURRENCY=USD
PRICE_STARTER=19
# AI changes allowed per month (keeps your AI bill under control)
AI_LIMIT_TRIAL=15
AI_LIMIT_STARTER=60

# ---- Card payments (Lemon Squeezy) ----
# Leave empty until you set it up; clients will be told to message you to pay instead.
LEMON_CHECKOUT_STARTER=
LEMON_CHECKOUT_BUSINESS=
LEMON_VARIANT_STARTER=
LEMON_VARIANT_BUSINESS=
LEMON_WEBHOOK_SECRET=

# Where the database and local bucket live (keep this on a disk that survives restarts)
# DATA_DIR=./data
